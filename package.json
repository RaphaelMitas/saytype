{
  "name": "saytype",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check src/ && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && ruff format --check sidecar/ tests/ && ruff check sidecar/ tests/",
    "check:fix": "biome check --write src/ && cargo fmt --manifest-path src-tauri/Cargo.toml && ruff format sidecar/ tests/ && ruff check --fix sidecar/ tests/",
    "typecheck": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml && pyright",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e:sidecar": "python3 tests/e2e/sidecar_e2e.py \"src-tauri/binaries/transcribe-server-$(rustc -vV | sed -n 's/^host: //p')\"",
    "e2e:app": "./tests/e2e/app_e2e.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "pyright": "^1.1.408",
    "typescript": "~7.0.0",
    "vite": "^8.0.0"
  }
}
