{
  "name": "saytype",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "test -f \"src-tauri/binaries/transcribe-server-$(rustc -vV | sed -n 's/^host: //p')\" || sidecar/build.sh && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings && ruff format --check sidecar/ tests/ && ruff check sidecar/ tests/",
    "check:fix": "biome check --write && cargo fmt --manifest-path src-tauri/Cargo.toml && ruff format sidecar/ tests/ && ruff check --fix sidecar/ tests/",
    "typecheck": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml && pyright",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "e2e:sidecar": "python3 tests/e2e/sidecar_e2e.py \"src-tauri/binaries/transcribe-server-$(rustc -vV | sed -n 's/^host: //p')\"",
    "e2e:app": "./tests/e2e/app_e2e.sh",
    "screenshots": "node scripts/screenshots/capture.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.64.1",
    "pyright": "^1.1.408",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.0",
    "vite": "^8.0.0"
  }
}
