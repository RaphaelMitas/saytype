{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": [
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "groupName": "tauri",
      "matchPackageNames": [
        "/^tauri/",
        "/^@tauri-apps//"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "rust dependencies (non-major)",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "build tools",
      "matchPackageNames": ["/^vite/", "/^@vitejs/", "typescript"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/sidecar/requirements\\.txt$/"
    ]
  }
}
